__pycache__/
*.pyc
state_*/
# 스모크 실행의 콘솔 덤프 — state_*/ 규칙에서 새던 것 (2026-08-24 정리)
state_*.out

# 비밀값(2026-07-25 두뇌 백엔드 어댑터) — 이 레포는 state/ 와 runs/*.jsonl 을 실제로
# 커밋한다. 키가 한 번 히스토리에 박히면 git rm 으로 못 지운다(rewrite + 키 폐기가
# 유일한 복구). 그래서 .env 를 만들기 *전에* 이 줄들이 먼저 있어야 한다.
.env
.env.*
!.env.example
*.key

# Claude 세션 기억 스냅샷(로컬 전용) — 공개 리포에 실리면 안 된다.
# 2026-08-10 filter-repo 로 히스토리에서도 제거했음. 로컬 폴더는 보관.
claude-memory/
