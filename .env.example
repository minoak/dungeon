# 두뇌 백엔드 비밀값 템플릿 — 실제 값은 .env 에만 넣는다(.gitignore 가 차단).
#
# ⚠️ ~/.bashrc 에 export 하지 말 것. 게이트(verify_*.py)는 .env 를 읽지 않도록
#    일부러 설계했다 — 키가 없는 프로세스에서는 모킹을 빠뜨려도 실 API 가 물리적으로
#    못 나간다(구조적 안전핀). 셸에 export 하면 그 안전핀이 통째로 무력화된다.
#
# 발급: Anthropic = console.anthropic.com > API Keys
#       Gemini    = aistudio.google.com > Get API key

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 두뇌 백엔드 스위치 — 기본은 claude_cli(구독 과금 0, 지금까지의 판과 동일).
# API 는 명시적으로 켤 때만 나간다.
#   claude_cli    : claude.exe 서브프로세스 (기본)
#   anthropic_api : Anthropic Messages API (HTTP)
#   gemini_api    : Gemini generateContent (HTTP)
#   dummy         : 콜 0 — 명시적인 규칙두뇌 테스트(실플레이 실패 시에는 사용하지 않음)
# 실플레이 판단 실패: 같은 관측으로 1회 재판단 → 계속 실패하면 원정 정지, 화면의 판단 재시도로 재개.
# DUNGEON_BRAIN_BACKEND=claude_cli

# 2026-09-11: 조합형 원정은 스킬·주사위 전투·3층 랜덤 획득이 기본 ON.
# 이전 규칙과 비교하려면 아래 세 값을 실행 환경에서 0으로 지정한다.
# DUNGEON_SKILLS=0
# DUNGEON_TRPG_COMBAT=0
# DUNGEON_RANDOM_SKILL=0
